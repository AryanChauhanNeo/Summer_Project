# ─────────────────────────────────────────────────────────────
# Smart Mars Rover Backend — environment configuration example
# Copy this file to ".env" and adjust values as needed.
# Nothing in the codebase hardcodes these — everything reads
# from here via app/config.py.
# ─────────────────────────────────────────────────────────────

# General
APP_NAME=Mars Rover Monitoring & Navigation Backend
APP_VERSION=1.0.0
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# CORS
# Use "*" for local development (all three teammates, different cities).
# For production, set a comma-separated list instead, e.g.:
# CORS_ORIGINS_RAW=https://your-dashboard.streamlit.app,http://localhost:8501
CORS_ORIGINS_RAW=*
